<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%231c1915'/%3E%3Ctext x='16' y='22' text-anchor='middle' font-family='Georgia,serif' font-size='18' fill='%23f4f0e6'%3ET%3C/text%3E%3C/svg%3E">
  <meta name="theme-color" content="#f4f0e6">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header">
    <a class="wordmark" href="/">{{ site.title }}</a>
    <nav>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
      <a href="/feed.xml">Feed</a>
    </nav>
  </header>
  <main id="content">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <a href="https://github.com/thalesreis/thalesreis.github.io">Source on GitHub</a>
  </footer>
</body>
</html>
